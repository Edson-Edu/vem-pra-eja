# Copie para supabase/functions/.env. O arquivo real é ignorado pelo Git.
# Use "mailpit" para capturar mensagens localmente ou "smtp" para envio real.
EMAIL_TRANSPORT=smtp

SMTP_HOST=mail.bc.sc.gov.br
SMTP_PORT=587
# A conta pessoal autentica; a identidade delegada abaixo aparece como remetente.
SMTP_USER=usuario-smtp@instituicao.br
SMTP_PASSWORD=COLOQUE_A_SENHA_DA_CONTA_AUTENTICADORA_SOMENTE_NO_ARQUIVO_LOCAL
SMTP_FROM=vempraeja@bc.sc.gov.br
SMTP_FROM_NAME=Vem Pra EJA

# Usado apenas quando EMAIL_TRANSPORT=mailpit.
MAILPIT_API_URL=http://inbucket:8025

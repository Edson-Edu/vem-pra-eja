DB_NAME=vempraeja
MIGRATION_DB_USER=postgres
MIGRATION_DB_PASSWORD=defina-uma-senha-forte-exclusiva-para-migrations
APP_DB_USER=vempraeja_app
APP_DB_PASSWORD=defina-outra-senha-forte-exclusiva-para-a-aplicacao
APP_ORIGIN=https://vempraeja.exemplo.ifc.edu.br
APP_PORT=3000
TRUST_PROXY=true
# Gere com uma fonte criptograficamente segura, por exemplo: openssl rand -hex 32
RATE_LIMIT_SECRET=gere-uma-chave-criptograficamente-segura
LOGIN_RATE_LIMIT_SECRET=gere-outra-chave-criptograficamente-segura
# O GEATI deve solicitar estes dois valores à equipe responsável pelo projeto
# e recebê-los por canal privado. Nunca envie a chave pelo GitHub.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Opcional; confirme os termos do provedor antes de substituir o padrão OSM.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
